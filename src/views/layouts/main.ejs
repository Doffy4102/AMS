<!DOCTYPE html>
<html lang="en" x-data="{ darkMode: document.documentElement.classList.contains('dark') }" :class="{ 'dark': darkMode, 'light': !darkMode }">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= brandName %> | Enterprise IT Operations</title>
<meta name="theme-color" content="#4f46e5">
<meta name="csrf-token" content="<%= csrf_token %>">
<link rel="manifest" href="/manifest.json">
<script>
(function() {
  var theme = localStorage.getItem('hams-theme') || 'dark';
  document.documentElement.classList.add(theme === 'light' ? 'light' : 'dark');
})();
</script>
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = {
  darkMode: 'class',
  theme: { extend: {
    colors: { hams: { bg: '#0a0a0b', card: '#141417', border: '#27272a', primary: '#3b82f6', accent: '#6366f1' } },
    fontFamily: { sans: ['Inter', 'sans-serif'], heading: ['Outfit', 'sans-serif'] }
  }}
};
</script>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<style>
:root { --hams-bg: #0a0a0b; --hams-card: #141417; --hams-border: rgba(255,255,255,.05); --hams-text: #e2e8f0; --hams-text-muted: #94a3b8; }
.light { --hams-bg: #f8fafc; --hams-card: #ffffff; --hams-border: rgba(15,23,42,.08); --hams-text: #0f172a; --hams-text-muted: #64748b; }
body { background: var(--hams-bg); color: var(--hams-text); font-family: 'Inter', sans-serif; }
h1,h2,h3,.font-heading { font-family: 'Outfit', sans-serif; }
.glass { background: var(--hams-card); backdrop-filter: blur(20px); border-bottom: 1px solid var(--hams-border); }
.table-responsive { overflow-x: auto; border-radius: 1.5rem; scrollbar-width: none; }
.table-responsive::-webkit-scrollbar { display: none; }
[x-cloak] { display: none !important; }
.light .bg-hams-bg { background-color: #f8fafc !important; }
.light .bg-hams-card { background-color: #ffffff !important; }
.light .text-white { color: #0f172a !important; }
.light .text-slate-200 { color: #1e293b !important; }
.light .text-slate-300 { color: #334155 !important; }
.light .text-slate-400 { color: #64748b !important; }
.light .text-slate-500 { color: #64748b !important; }
.light .border-white\/5 { border-color: rgba(15,23,42,.08) !important; }
.light .bg-white\/5 { background-color: rgba(15,23,42,.04) !important; }
.light .divide-white\/5 > * { border-color: rgba(15,23,42,.06) !important; }
.light input, .light select, .light textarea { color-scheme: light; }
.dark input, .dark select, .dark textarea { color-scheme: dark; }
input, select, textarea { background: var(--hams-bg); border: 1px solid var(--hams-border); color: var(--hams-text); }
</style>
</head>
<body class="bg-hams-bg text-slate-200 antialiased overflow-x-hidden"
      x-data="{ sidebarOpen: window.innerWidth >= 1024, isMobile: window.innerWidth < 1024 }"
      @resize.window="isMobile = window.innerWidth < 1024; if (!isMobile) sidebarOpen = true">

<!-- Command palette -->
<div x-data="{ open: false, query: '' }" @keydown.window.ctrl.k.prevent="open = true; $nextTick(() => $refs.searchInput && $refs.searchInput.focus())"
     @open-command-palette.window="open = true; $nextTick(() => $refs.searchInput && $refs.searchInput.focus())"
     @keydown.escape.window="open = false" x-cloak>
  <div x-show="open" class="fixed inset-0 z-[100] flex items-start justify-center pt-24 px-4">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" @click="open = false"></div>
    <div class="relative w-full max-w-xl bg-hams-card border border-white/10 rounded-2xl shadow-2xl overflow-hidden">
      <input x-ref="searchInput" x-model="query" type="text" placeholder="Search assets, users, actions..."
             class="w-full px-5 py-4 bg-transparent border-0 border-b border-white/5 outline-none text-sm">
      <div class="p-3 text-xs text-slate-500 uppercase tracking-wider px-5">Navigation &amp; Quick Actions</div>
      <div class="pb-3 max-h-80 overflow-y-auto">
        <% const paletteLinks = [
          ['Add New Asset', '/assets/create', 'plus', 'blue', 'add new asset create hardware'],
          ['Assets Catalog', '/assets', 'laptop', 'indigo', 'assets catalog hardware list'],
          ['License Manager', '/inventory/licenses', 'key-round', 'pink', 'license software seats'],
          ['Stock & Inventory', '/inventory', 'package', 'amber', 'stock inventory consumables accessories'],
          ['Operations & Maintenance', '/maintenance', 'wrench', 'orange', 'operations maintenance repair'],
          ['Archive & Soft-Deletes', '/archive', 'archive', 'purple', 'archive deleted restore'],
          ['Audit & Monitoring', '/settings/monitoring', 'activity', 'emerald', 'audit monitoring health']
        ]; %>
        <% for (const [label, href, icon, color, keywords] of paletteLinks) { %>
        <a href="<%= hams_url(href) %>" x-show="!query || '<%= keywords %>'.includes(query.toLowerCase())"
           class="flex items-center gap-3 px-5 py-2.5 hover:bg-white/5 text-sm">
          <span class="w-8 h-8 rounded-lg bg-<%= color %>-500/15 text-<%= color %>-400 flex items-center justify-center"><i data-lucide="<%= icon %>" class="w-4 h-4"></i></span>
          <%= label %>
        </a>
        <% } %>
      </div>
      <div class="px-5 py-2 border-t border-white/5 text-[10px] text-slate-500 flex justify-between">
        <span>Enterprise Search Engine v1.0</span><span>&uarr;&darr; to navigate &middot; ENTER to select</span>
      </div>
    </div>
  </div>
</div>

<div class="flex h-screen overflow-hidden">
  <!-- Mobile backdrop -->
  <div x-show="isMobile && sidebarOpen" class="fixed inset-0 bg-black/50 z-30 lg:hidden" @click="sidebarOpen = false" x-cloak></div>

  <!-- Sidebar -->
  <aside class="fixed lg:static inset-y-0 left-0 z-40 w-72 bg-hams-card border-r border-white/5 flex flex-col transition-transform duration-200"
         :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full lg:-translate-x-full lg:hidden'" x-show="sidebarOpen || !isMobile" x-cloak>
    <div class="h-20 md:h-24 flex items-center gap-3 px-6 border-b border-white/5 shrink-0">
      <% if (brandLogo) { %>
        <img src="<%= brandLogo %>" alt="logo" class="w-10 h-10 rounded-xl object-contain">
      <% } else { %>
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-lg font-heading"><%= brandName.charAt(0) %></div>
      <% } %>
      <div class="min-w-0">
        <div class="font-heading font-semibold text-white truncate"><%= brandName %></div>
        <div class="text-[11px] text-slate-500 truncate"><%= brandTagline %></div>
      </div>
    </div>

    <nav class="flex-1 overflow-y-auto px-4 py-5 space-y-6 text-sm">
      <%
      const navClass = (prefix) => {
        const active = prefix === '/' ? (currentPath === '/' || currentPath === '/dashboard') : currentPath.startsWith(prefix);
        return active
          ? 'flex items-center gap-3 px-3 py-2 rounded-xl bg-blue-600/10 text-blue-500 font-medium border-l-2 border-blue-500'
          : 'flex items-center gap-3 px-3 py-2 rounded-xl text-slate-400 hover:text-white hover:bg-white/5';
      };
      const canDashboard = await canNav('dashboard.view');
      %>
      <% if (!canDashboard) { %>
      <div>
        <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Employee Portal</div>
        <a href="<%= hams_url('/portal/dashboard') %>" class="<%= navClass('/portal/dashboard') %>"><i data-lucide="layout-dashboard" class="w-4 h-4"></i>Overview</a>
        <a href="<%= hams_url('/portal/my-assets') %>" class="<%= navClass('/portal/my-assets') %>"><i data-lucide="laptop" class="w-4 h-4"></i>My Assets</a>
        <a href="<%= hams_url('/portal/requests') %>" class="<%= navClass('/portal/requests') %>"><i data-lucide="message-square" class="w-4 h-4"></i>My Requests</a>
      </div>
      <% } else { %>
      <div>
        <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Core Systems</div>
        <a href="<%= hams_url('/') %>" class="<%= navClass('/') %>"><i data-lucide="layout-dashboard" class="w-4 h-4"></i>Dashboard</a>
      </div>
      <% const canPeopleView = await canNav('personnel.view', 'personnel');
         const canPeopleManage = await canNav('personnel.manage', 'personnel');
         const canSettingsManage = await canNav('settings.manage', 'settings'); %>
      <% if (canPeopleView || canPeopleManage || canSettingsManage) { %>
      <div>
        <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Administration</div>
        <% if (canPeopleView) { %>
        <a href="<%= hams_url('/users') %>" class="<%= navClass('/users') %>"><i data-lucide="users" class="w-4 h-4"></i>Enterprise Directory</a>
        <a href="<%= hams_url('/users/ldap') %>" class="<%= navClass('/users/ldap') %>"><i data-lucide="network" class="w-4 h-4"></i>LDAP Directory &amp; Sync</a>
        <% } %>
        <% if (canPeopleManage) { %>
        <a href="<%= hams_url('/settings/roles') %>" class="<%= navClass('/settings/roles') %>"><i data-lucide="shield-check" class="w-4 h-4"></i>Roles &amp; Permissions</a>
        <% } %>
        <% if (canSettingsManage) { %>
        <a href="<%= hams_url('/settings/identity') %>" class="<%= navClass('/settings/identity') %>"><i data-lucide="fingerprint" class="w-4 h-4"></i>Identity &amp; SSO</a>
        <a href="<%= hams_url('/settings/security') %>" class="<%= navClass('/settings/security') %>"><i data-lucide="shield" class="w-4 h-4"></i>Security Center</a>
        <a href="<%= hams_url('/agents') %>" class="<%= navClass('/agents') %>"><i data-lucide="radio" class="w-4 h-4"></i>Endpoint Agents</a>
        <a href="<%= hams_url('/settings/branding') %>" class="<%= navClass('/settings') %>"><i data-lucide="settings" class="w-4 h-4"></i>All Settings</a>
        <% } %>
      </div>
      <% } %>
      <% const canAssets = await canNav('assets.view', 'assets');
         const canMaint = await canNav('maintenance.view', 'maintenance');
         const canInv = await canNav('inventory.view', 'inventory');
         const canLic = await canNav('licenses.view', 'licenses'); %>
      <% if (canAssets || canInv || canMaint) { %>
      <div>
        <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Asset Management</div>
        <% if (canAssets) { %>
        <a href="<%= hams_url('/new-joinees') %>" class="<%= navClass('/new-joinees') %>"><i data-lucide="user-check" class="w-4 h-4"></i>New Joinees</a>
        <a href="<%= hams_url('/assets') %>" class="<%= navClass('/assets') %>"><i data-lucide="laptop" class="w-4 h-4"></i>Hardware</a>
        <a href="<%= hams_url('/procurement') %>" class="<%= navClass('/procurement') %>"><i data-lucide="receipt" class="w-4 h-4"></i>Procurement</a>
        <a href="<%= hams_url('/assets/scan') %>" class="<%= navClass('/assets/scan') %>"><i data-lucide="qr-code" class="w-4 h-4"></i>Mobile Scanner</a>
        <a href="<%= hams_url('/portal/scan') %>" class="<%= navClass('/portal/scan') %>"><i data-lucide="scan-barcode" class="w-4 h-4"></i>Barcode Scanner</a>
        <% } %>
        <% if (canMaint) { %><a href="<%= hams_url('/maintenance') %>" class="<%= navClass('/maintenance') %>"><i data-lucide="wrench" class="w-4 h-4"></i>Maintenance</a><% } %>
        <% if (canInv) { %>
        <a href="<%= hams_url('/inventory/accessories') %>" class="<%= navClass('/inventory/accessories') %>"><i data-lucide="mouse" class="w-4 h-4"></i>Accessories</a>
        <a href="<%= hams_url('/inventory/components') %>" class="<%= navClass('/inventory/components') %>"><i data-lucide="cpu" class="w-4 h-4"></i>Components</a>
        <% } %>
      </div>
      <% } %>
      <% if (canLic) { %>
      <div>
        <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">License Management</div>
        <a href="<%= hams_url('/inventory/licenses') %>" class="<%= navClass('/inventory/licenses') %>"><i data-lucide="key-round" class="w-4 h-4"></i>Licenses</a>
        <a href="<%= hams_url('/software') %>" class="<%= navClass('/software') %>"><i data-lucide="app-window" class="w-4 h-4"></i>Software</a>
        <a href="<%= hams_url('/license-allocation') %>" class="<%= navClass('/license-allocation') %>"><i data-lucide="gauge" class="w-4 h-4"></i>License Allocation &amp; Utilization</a>
        <% if (await canNav('licenses.manage_setup', 'licenses')) { %>
        <a href="<%= hams_url('/licenses/setup') %>" class="<%= navClass('/licenses/setup') %>"><i data-lucide="sliders-horizontal" class="w-4 h-4"></i>License Setup</a>
        <% } %>
      </div>
      <% } %>
      <% if (canInv) { %>
      <div>
        <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Inventory Module</div>
        <a href="<%= hams_url('/inventory/consumables') %>" class="<%= navClass('/inventory/consumables') %>"><i data-lucide="package-minus" class="w-4 h-4"></i>Consumables</a>
        <a href="<%= hams_url('/inventory-setup') %>" class="<%= navClass('/inventory-setup') %>"><i data-lucide="boxes" class="w-4 h-4"></i>Inventory Setup</a>
        <a href="<%= hams_url('/stock-movements') %>" class="<%= navClass('/stock-movements') %>"><i data-lucide="arrow-left-right" class="w-4 h-4"></i>Stock Movements</a>
      </div>
      <% } %>
      <div>
        <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Analytics</div>
        <% if ((await canNav('reports.view', 'reports')) || (await canNav('reports.create', 'reports')) || (await canNav('reports.manage', 'reports'))) { %>
        <a href="<%= hams_url('/reports') %>" class="<%= navClass('/reports') %>"><i data-lucide="file-bar-chart" class="w-4 h-4"></i>Reports</a>
        <% } %>
        <% if (await canNav('reports.create')) { %>
        <a href="<%= hams_url('/import') %>" class="<%= navClass('/import') %>"><i data-lucide="file-up" class="w-4 h-4"></i>Import Center</a>
        <% } %>
        <% if (await canNav('requests.approve', 'requests')) { %>
        <a href="<%= hams_url('/requests') %>" class="<%= navClass('/requests') %>"><i data-lucide="clipboard-list" class="w-4 h-4"></i>Requests</a>
        <% } %>
      </div>
      <div>
        <div class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-wider">My Workspace</div>
        <a href="<%= hams_url('/portal/my-assets') %>" class="<%= navClass('/portal/my-assets') %>"><i data-lucide="laptop" class="w-4 h-4"></i>My Assets</a>
        <a href="<%= hams_url('/portal/requests') %>" class="<%= navClass('/portal/requests') %>"><i data-lucide="message-square" class="w-4 h-4"></i>My Requests</a>
      </div>
      <% } %>
    </nav>
  </aside>

  <!-- Main -->
  <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <header class="h-20 md:h-24 glass flex items-center gap-4 px-4 md:px-8 shrink-0 z-20">
      <button @click="sidebarOpen = !sidebarOpen" class="p-2 rounded-xl hover:bg-white/5 text-slate-400"><i data-lucide="menu" class="w-5 h-5"></i></button>
      <button @click="$dispatch('open-command-palette')"
              class="flex-1 max-w-md flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-white/5 border border-white/5 text-slate-500 text-sm hover:border-white/10">
        <i data-lucide="search" class="w-4 h-4"></i>
        <span class="hidden md:inline">Search everything&hellip;</span><span class="md:hidden">Search&hellip;</span>
        <kbd class="ml-auto text-[10px] px-1.5 py-0.5 rounded bg-white/10 hidden md:inline">Ctrl + K</kbd>
      </button>
      <div class="ml-auto flex items-center gap-2">
        <% if (currentUser) { %>
        <button id="hams-ai-btn" title="HAMS AI Assistant" class="flex items-center gap-2 px-3 py-2.5 rounded-xl bg-gradient-to-r from-violet-600/20 to-blue-600/20 border border-violet-500/30 hover:border-violet-400/60 text-violet-300 text-sm font-medium">
          <i data-lucide="sparkles" class="w-4 h-4"></i><span class="hidden md:inline">Ask AI</span>
        </button>
        <% } %>
        <% if (currentUser && (await canNav('settings.manage'))) { %>
        <a href="<%= hams_url('/settings/branding') %>" class="p-2.5 rounded-xl hover:bg-white/5 <%= currentPath.startsWith('/settings') ? 'text-blue-500' : 'text-slate-400' %>"><i data-lucide="settings" class="w-5 h-5"></i></a>
        <% } %>
        <button @click="darkMode = !darkMode; localStorage.setItem('hams-theme', darkMode ? 'dark' : 'light')" class="p-2.5 rounded-xl hover:bg-white/5 text-slate-400">
          <i data-lucide="moon" class="w-5 h-5" x-show="darkMode"></i>
          <i data-lucide="sun" class="w-5 h-5" x-show="!darkMode" x-cloak></i>
        </button>
        <% if (currentUser && canDashboard) { %>
        <div x-data="{ createNewOpen: false }" class="relative" @click.outside="createNewOpen = false">
          <button @click="createNewOpen = !createNewOpen" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium">
            <i data-lucide="plus" class="w-4 h-4"></i><span class="hidden md:inline">Create New</span>
          </button>
          <div x-show="createNewOpen" x-cloak x-transition class="absolute right-0 mt-2 w-56 bg-hams-card border border-white/10 rounded-2xl shadow-xl py-2 z-[150]">
            <% if (await canNav('assets.create', 'assets')) { %><a href="<%= hams_url('/assets/create') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="laptop" class="w-4 h-4"></i>Hardware</a><% } %>
            <% if (await canNav('licenses.create', 'licenses')) { %><a href="<%= hams_url('/inventory/licenses') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="key-round" class="w-4 h-4"></i>Licenses</a><% } %>
            <% if (await canNav('inventory.create', 'inventory')) { %>
            <a href="<%= hams_url('/inventory/accessories') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="mouse" class="w-4 h-4"></i>Accessories</a>
            <a href="<%= hams_url('/inventory/consumables') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="package-minus" class="w-4 h-4"></i>Consumables</a>
            <a href="<%= hams_url('/inventory/components') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="cpu" class="w-4 h-4"></i>Components</a>
            <% } %>
            <% if (await canNav('personnel.create', 'personnel')) { %>
            <div class="my-1 border-t border-white/5"></div>
            <a href="<%= hams_url('/users') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="users" class="w-4 h-4"></i>Users</a>
            <% } %>
          </div>
        </div>
        <% } %>
        <% if (currentUser) { %>
        <div x-data="{ profileOpen: false }" class="relative" @click.outside="profileOpen = false">
          <button @click="profileOpen = !profileOpen" class="flex items-center gap-3 pl-2 pr-3 py-1.5 rounded-2xl hover:bg-white/5">
            <img src="<%= currentUser.avatar_url ? '/' + currentUser.avatar_url : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(currentUser.name) + '&background=3b82f6&color=fff' %>"
                 class="w-9 h-9 rounded-xl object-cover" alt="avatar">
            <span class="hidden md:block text-sm font-medium text-white max-w-[120px] truncate"><%= currentUser.name %></span>
            <i data-lucide="chevron-down" class="w-4 h-4 text-slate-500 transition-transform" :class="profileOpen && 'rotate-180'"></i>
          </button>
          <div x-show="profileOpen" x-cloak x-transition class="absolute right-0 mt-2 w-60 bg-hams-card border border-white/10 rounded-2xl shadow-xl py-2 z-[150]">
            <a href="<%= hams_url('/portal/my-assets') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="laptop" class="w-4 h-4"></i>My Assets</a>
            <a href="<%= hams_url('/portal/requests') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="message-square" class="w-4 h-4"></i>My Requests</a>
            <% if (await canNav('requests.approve', 'requests')) { %>
            <a href="<%= hams_url('/requests') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="clipboard-list" class="w-4 h-4"></i>Requests</a>
            <% } %>
            <div class="my-1 border-t border-white/5"></div>
            <a href="<%= hams_url('/profile') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="user" class="w-4 h-4"></i>Edit Profile</a>
            <a href="<%= hams_url('/profile') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="key" class="w-4 h-4"></i>Change Password</a>
            <button @click="darkMode = !darkMode; localStorage.setItem('hams-theme', darkMode ? 'dark' : 'light')" class="w-full flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5">
              <i data-lucide="moon" class="w-4 h-4"></i>Dark Mode <span class="ml-auto text-xs text-slate-500" x-text="darkMode ? 'ON' : 'OFF'"></span>
            </button>
            <% if (isSuperAdmin) { %>
            <div class="my-1 border-t border-white/5"></div>
            <a href="<%= hams_url('/settings/api-tokens') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="key-round" class="w-4 h-4"></i>Manage API keys</a>
            <a href="<%= hams_url('/logs') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-300 hover:bg-white/5"><i data-lucide="scroll-text" class="w-4 h-4"></i>Log Viewer</a>
            <% } %>
            <div class="my-1 border-t border-white/5"></div>
            <a href="<%= hams_url('/logout') %>" class="flex items-center gap-3 px-4 py-2 text-sm text-rose-400 hover:bg-rose-500/10"><i data-lucide="log-out" class="w-4 h-4"></i>Logout</a>
          </div>
        </div>
        <% } %>
      </div>
    </header>

    <div class="flex-1 overflow-y-auto px-4 md:px-8 py-6 md:py-8">
      <% for (const [key, color] of [['success', 'emerald'], ['error', 'rose']]) { if (flash[key]) { %>
      <div class="mb-6 px-5 py-4 rounded-2xl border bg-<%= color %>-500/10 border-<%= color %>-500/20 text-<%= color %>-300 text-sm font-medium"><%= flash[key] %></div>
      <% } } %>
      <%- content %>
    </div>
  </main>
</div>

<% if (currentUser) { %>
<!-- HAMS AI Assistant drawer -->
<div id="hams-ai-backdrop" class="fixed inset-0 z-[170] hidden bg-black/50 backdrop-blur-sm"></div>
<div id="hams-ai-panel" class="fixed inset-y-0 right-0 z-[180] w-full sm:w-[440px] hidden flex-col bg-hams-card border-l border-white/10 shadow-2xl">
  <div class="flex items-center gap-3 px-5 py-4 border-b border-white/5 shrink-0">
    <span class="w-9 h-9 rounded-xl bg-gradient-to-br from-violet-500 to-blue-600 flex items-center justify-center text-white"><i data-lucide="sparkles" class="w-4 h-4"></i></span>
    <div class="min-w-0">
      <div class="font-heading font-semibold text-white text-sm">HAMS AI Assistant</div>
      <div class="text-[11px] text-slate-500">Answers from your live data — markets, clients, software, spend &amp; more</div>
    </div>
    <button id="hams-ai-close" class="ml-auto p-2 rounded-lg hover:bg-white/5 text-slate-400"><i data-lucide="x" class="w-4 h-4"></i></button>
  </div>

  <div id="hams-ai-messages" class="flex-1 overflow-y-auto px-5 py-4 space-y-4 text-sm"></div>

  <div id="hams-ai-suggestions" class="px-5 pb-2 shrink-0 flex flex-wrap gap-2">
    <button data-ai-suggest="How many software products do we have for Athena in HMT2?" class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] text-slate-300">Software for Athena in HMT2</button>
    <button data-ai-suggest="Which market has the highest number of licenses?" class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] text-slate-300">Top market by licenses</button>
    <button data-ai-suggest="What are our estimated savings?" class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] text-slate-300">Estimated savings</button>
    <button data-ai-suggest="What renews in the next 90 days?" class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] text-slate-300">Upcoming renewals</button>
    <button data-ai-suggest="What can you do?" class="px-3 py-1.5 rounded-full bg-white/5 hover:bg-white/10 border border-white/10 text-[11px] text-slate-300">What can you do?</button>
  </div>

  <div class="px-5 py-4 border-t border-white/5 shrink-0">
    <form id="hams-ai-form" class="flex items-center gap-2">
      <input id="hams-ai-input" type="text" maxlength="500" placeholder="Ask about markets, clients, software, spend…" autocomplete="off"
             class="flex-1 px-4 py-2.5 rounded-xl bg-hams-bg border border-white/10 text-sm text-slate-200 focus:border-violet-500/60 outline-none">
      <button type="submit" id="hams-ai-send" class="p-2.5 rounded-xl bg-violet-600 hover:bg-violet-500 text-white disabled:opacity-40"><i data-lucide="send" class="w-4 h-4"></i></button>
    </form>
  </div>
</div>

<script>
(function() {
  var AI_URL = <%- JSON.stringify(hams_url('/assistant/query')) %>;
  var panel = document.getElementById('hams-ai-panel');
  var backdrop = document.getElementById('hams-ai-backdrop');
  var messages = document.getElementById('hams-ai-messages');
  var suggestions = document.getElementById('hams-ai-suggestions');
  var input = document.getElementById('hams-ai-input');
  var sendBtn = document.getElementById('hams-ai-send');
  var esc = function(s) { return String(s).replace(/[&<>"]/g, function(c) { return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]; }); };
  var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';

  function openPanel() {
    panel.classList.remove('hidden'); panel.classList.add('flex');
    backdrop.classList.remove('hidden');
    if (!messages.children.length) {
      addBubble('bot', '<p>Hi! I answer questions straight from your HAMS data. Try one of the suggestions below, or ask anything about markets, clients, software, licenses, spending or renewals.</p>');
    }
    setTimeout(function() { input.focus(); }, 50);
  }
  function closePanel() {
    panel.classList.add('hidden'); panel.classList.remove('flex');
    backdrop.classList.add('hidden');
  }
  document.getElementById('hams-ai-btn').addEventListener('click', openPanel);
  document.getElementById('hams-ai-close').addEventListener('click', closePanel);
  backdrop.addEventListener('click', closePanel);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closePanel(); });

  function addBubble(who, html) {
    var wrap = document.createElement('div');
    if (who === 'user') {
      wrap.className = 'flex justify-end';
      wrap.innerHTML = '<div class="max-w-[85%] px-4 py-2.5 rounded-2xl rounded-br-sm bg-blue-600 text-white">' + html + '</div>';
    } else {
      wrap.className = 'flex justify-start';
      wrap.innerHTML = '<div class="max-w-[95%] px-4 py-3 rounded-2xl rounded-bl-sm bg-white/5 border border-white/5 text-slate-200 space-y-3 overflow-hidden">' + html + '</div>';
    }
    messages.appendChild(wrap);
    messages.scrollTop = messages.scrollHeight;
    return wrap;
  }

  function renderAnswer(a) {
    var html = '';
    if (a.summary) html += '<p class="leading-relaxed">' + esc(a.summary) + '</p>';
    if (a.metrics && a.metrics.length) {
      html += '<div class="grid grid-cols-2 gap-2">' + a.metrics.map(function(m) {
        return '<div class="px-3 py-2 rounded-xl bg-white/5 border border-white/5"><div class="text-[10px] uppercase tracking-wider text-slate-500">' + esc(m.label) + '</div><div class="text-sm font-semibold text-white">' + esc(m.value) + '</div></div>';
      }).join('') + '</div>';
    }
    if (a.table && a.table.rows && a.table.rows.length) {
      html += '<div class="overflow-x-auto rounded-xl border border-white/10"><table class="w-full text-xs"><thead><tr class="text-left text-slate-500 uppercase bg-white/5">' +
        a.table.columns.map(function(c) { return '<th class="px-3 py-2 whitespace-nowrap">' + esc(c) + '</th>'; }).join('') +
        '</tr></thead><tbody class="divide-y divide-white/5">' +
        a.table.rows.slice(0, 15).map(function(r) {
          return '<tr>' + r.map(function(c) { return '<td class="px-3 py-2 whitespace-nowrap text-slate-300">' + esc(c) + '</td>'; }).join('') + '</tr>';
        }).join('') + '</tbody></table></div>';
      if (a.table.rows.length > 15) html += '<p class="text-[11px] text-slate-500">Showing 15 of ' + a.table.rows.length + ' rows.</p>';
    }
    if (a.insights && a.insights.length) {
      html += '<div class="space-y-1">' + a.insights.map(function(i) {
        return '<p class="text-[12px] text-slate-400 flex gap-1.5"><span class="text-violet-400">◆</span><span>' + esc(i) + '</span></p>';
      }).join('') + '</div>';
    }
    if (a.recommendations && a.recommendations.length) {
      html += '<div class="space-y-1">' + a.recommendations.map(function(r) {
        return '<p class="text-[12px] text-emerald-300/90 flex gap-1.5"><span>→</span><span>' + esc(r) + '</span></p>';
      }).join('') + '</div>';
    }
    return html || '<p>I could not build an answer for that.</p>';
  }

  function send(question) {
    question = (question || '').trim();
    if (!question) return;
    suggestions.classList.add('hidden');
    addBubble('user', esc(question));
    input.value = '';
    sendBtn.disabled = true;
    var typing = addBubble('bot', '<span class="inline-flex gap-1 items-center text-slate-400"><span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-bounce"></span><span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-bounce" style="animation-delay:.15s"></span><span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-bounce" style="animation-delay:.3s"></span></span>');
    fetch(AI_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ _csrf: csrf, question: question })
    })
      .then(function(res) { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); })
      .then(function(a) { typing.remove(); addBubble('bot', renderAnswer(a)); })
      .catch(function(err) { typing.remove(); addBubble('bot', '<p class="text-rose-300">Something went wrong (' + esc(err.message) + '). Please try again.</p>'); })
      .finally(function() { sendBtn.disabled = false; input.focus(); });
  }

  document.getElementById('hams-ai-form').addEventListener('submit', function(e) { e.preventDefault(); send(input.value); });
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') { e.preventDefault(); send(input.value); }
  });
  suggestions.addEventListener('click', function(e) {
    var b = e.target.closest('[data-ai-suggest]');
    if (b) send(b.dataset.aiSuggest);
  });
})();
</script>
<% } %>

<!-- Global confirm modal -->
<div id="hams-confirm-modal" class="fixed inset-0 z-[200] hidden items-center justify-center px-4">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="relative bg-hams-card border border-white/10 rounded-2xl p-6 max-w-sm w-full shadow-2xl">
    <div class="flex items-center gap-3 mb-3">
      <span class="w-10 h-10 rounded-xl bg-rose-500/15 text-rose-400 flex items-center justify-center"><i data-lucide="triangle-alert" class="w-5 h-5"></i></span>
      <h3 class="font-heading font-semibold text-white">Confirm Action</h3>
    </div>
    <p id="hams-confirm-message" class="text-sm text-slate-400 mb-5"></p>
    <div class="flex justify-end gap-2">
      <button data-confirm-cancel class="px-4 py-2 rounded-xl bg-white/5 text-sm text-slate-300 hover:bg-white/10">Cancel</button>
      <button data-confirm-ok class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-sm text-white font-medium">Confirm</button>
    </div>
  </div>
</div>

<script>
window.addEventListener('load', function() { if (window.lucide) lucide.createIcons(); });
document.addEventListener('DOMContentLoaded', function() { if (window.lucide) lucide.createIcons(); });

// Global confirm modal wiring (data-confirm on forms, data-confirm-click on buttons)
(function() {
  var modal = document.getElementById('hams-confirm-modal');
  var msgEl = document.getElementById('hams-confirm-message');
  var pending = null;
  function show(message, onOk) {
    msgEl.textContent = message;
    pending = onOk;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function hide() { modal.classList.add('hidden'); modal.classList.remove('flex'); pending = null; }
  modal.querySelector('[data-confirm-cancel]').addEventListener('click', hide);
  modal.querySelector('[data-confirm-ok]').addEventListener('click', function() { var fn = pending; hide(); if (fn) fn(); });
  document.addEventListener('submit', function(e) {
    var form = e.target.closest('form[data-confirm]');
    if (form && !form.dataset.confirmed) {
      e.preventDefault();
      show(form.dataset.confirm, function() { form.dataset.confirmed = '1'; form.submit(); });
    }
  }, true);
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-confirm-click]');
    if (btn && !btn.dataset.confirmed) {
      e.preventDefault();
      show(btn.dataset.confirmClick, function() {
        btn.dataset.confirmed = '1';
        if (btn.formAction && btn.form) { btn.form.action = btn.formAction; btn.form.submit(); }
        else btn.click();
      });
    }
  }, true);
})();

// Barcode scan helper (BarcodeDetector with prompt fallback)
document.addEventListener('click', async function(e) {
  var btn = e.target.closest('[data-barcode-scan]');
  if (!btn) return;
  var fieldName = btn.dataset.barcodeScan;
  var input = document.querySelector('[name="' + fieldName + '"], [data-barcode-target="' + fieldName + '"]');
  if (!input) return;
  var code = window.prompt('Scan or enter barcode value:');
  if (code) { input.value = code; input.dispatchEvent(new Event('input')); }
});

if ('serviceWorker' in navigator) {
  window.addEventListener('load', function() {
    navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' }).catch(function() {});
  });
}
</script>
</body>
</html>
